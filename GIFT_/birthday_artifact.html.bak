</script>
<script>
/* ══════════════════════════════════════════════════════════════
   CONFIG — EDIT EVERYTHING BELOW. THIS IS THE ONLY SECTION YOU
   NEED TO TOUCH TO CUSTOMIZE THE ENTIRE SITE.
   ══════════════════════════════════════════════════════════════ */
let CONFIG = {

  // ── HER NAME ──
  name: "Harpreet",

  // ── ENTRY / LANDING SCREEN ──
  entryHeading: "You've got a surprise!",
  entrySub: "something special is waiting for you",
  entryBtn: "Open Your Surprise 🎁",

  // ── HERO SECTION ──
  heroBadge: "✨ It's Your Special Day ✨",
  heroTitle: "Happy Birthday",
  heroSub: "Today the world gets to celebrate the person who makes everything a little brighter, a little softer, and a lot more fun.",

  // ── MEMORIES (FRIENDSHIP MEMORY LANE) ──
  // Add/remove objects freely — the page rebuilds automatically.
  // photo: "" shows an animated placeholder. Paste an image URL to replace it.
  memories: [
    {
      date: "Where It Began",
      emoji: "🌱",
      title: "The Day We First Met",
      text: "I still remember how random it felt — two strangers who somehow ended up talking for hours like we'd known each other for years. I don't think either of us expected that first conversation to turn into everything it became. But looking back, that day quietly changed everything.",
      photo: ""
    },
    {
      date: "That One Night",
      emoji: "🌙",
      title: "Talks That Went Past 2 A.M.",
      text: "There's something about late-night conversations that make people say what they actually mean. We've had so many of those — voices getting sleepier, laughter getting louder, secrets we never told anyone else. Those nights taught me who you really are, and I've loved every version of you since.",
      photo: ""
    },
    {
      date: "The Good Kind of Chaos",
      emoji: "😂",
      title: "Laughing Until It Hurt",
      text: "I don't even remember what was so funny half the time — that's the thing about laughing with you, the reason stops mattering. What I do remember is my stomach hurting, tears in my eyes, and thinking 'I hope we're still doing this when we're old.'",
      photo: ""
    },
    {
      date: "When It Got Hard",
      emoji: "🫂",
      title: "You Stayed Anyway",
      text: "There were seasons that weren't easy — for both of us. And through all of it, you never once made me feel like I was too much or not enough. You just stayed. Showed up. Sat with me in it. That kind of loyalty isn't common, and I don't take it for granted.",
      photo: ""
    },
    {
      date: "Right Now",
      emoji: "💫",
      title: "Still Here, Still Us",
      text: "Life has changed so much since the day we met — new places, new people, new chapters. But somehow, we're still here, still us, still finishing each other's sentences. If that's not proof that some friendships are just meant to last, I don't know what is.",
      photo: ""
    }
  ],

  // ── WHAT YOU MEAN TO US ──
  meanings: [
    { emoji: "🏡", title: "You're Our Safe Place", text: "With you, there's no need to pretend. You've built a space where it's always okay to just be exactly who we are." },
    { emoji: "🕯️", title: "You Carry Light", text: "Even on your hardest days, you find a way to make the people around you feel a little lighter. That's a rare kind of strength." },
    { emoji: "🧩", title: "You're The Missing Piece", text: "Somehow every plan, every memory, every inside joke feels incomplete without you. You just fit, effortlessly." },
    { emoji: "🌟", title: "You Make Us Better", text: "Knowing you has quietly pushed all of us to be kinder, braver, and more ourselves. That's a gift not everyone gives." },
    { emoji: "🤝", title: "Our Favorite Partner in Crime", text: "From spontaneous plans to terrible decisions we'd make all over again — every good story somehow has you in it." },
    { emoji: "💎", title: "You're Simply Irreplaceable", text: "People like you don't come around twice. We know exactly how lucky we are to have you, today and always." }
  ],

  // ── PHOTO GALLERY ──
  // src: "" shows an animated placeholder. Paste an image URL to replace it.
  photos: [
    { src: "", caption: "A memory saved for you 📸" },
    { src: "", caption: "That day we couldn't stop laughing 😂" },
    { src: "", caption: "Somewhere, sometime, being silly 🤍" },
    { src: "", caption: "One of the good ones 💫" },
    { src: "", caption: "This one lives in our group chat forever" },
    { src: "", caption: "More memories coming soon 🎞️" }
  ],

  // ── REASONS YOU'RE SPECIAL (FLIP CARDS) ──
  reasons: [
    { text: "Your laugh is literally contagious — one room hears it and suddenly everyone's smiling for no reason.", emoji: "😄" },
    { text: "You remember the tiny details people mention once — and somehow that always makes us feel truly seen.", emoji: "🎯" },
    { text: "You give the most brutally honest advice, and somehow it always comes from the kindest place.", emoji: "💡" },
    { text: "You've never once made anyone feel small for needing help — you just show up, no questions asked.", emoji: "🤲" },
    { text: "Your playlists are unreasonably good and we will never admit how many are stolen from you.", emoji: "🎧" },
    { text: "You turn ordinary Tuesdays into core memories without even trying. That's a rare kind of magic.", emoji: "✨" }
  ],

  // ── LETTER SECTION ──
  letterGreeting: "Dear Harpreet,",
  letterBody: `If you're reading this, it means you actually tapped the envelope — so first, hi. I've been wanting to say all of this properly for a while.

Thank you for every 2 a.m. call you picked up without even asking why I was calling so late. Thank you for seeing straight through my "I'm fine" texts when I clearly wasn't, and never letting me get away with it.

We've built something over the years that honestly feels unbreakable — through distance, through busy seasons, through versions of ourselves that kept changing. And somehow, you never left.

You deserve every good thing this year is about to bring you. A birthday as beautiful, warm, and real as the friendship you've given all of us.

Happy birthday. I hope today feels exactly as special as you make everyone else feel, every single day.`,
  letterSign: "With all my love, always.",

  // ── INTERACTIVE CAKE ──
  cakeText: "Tap the cake to blow out the candles 💨",
  cakeWish: "Your wish is on its way 💫",

  // ── GRAND FINALE ──
  finaleLine: "Happiest Birthday to the most amazing person",
  finaleWish: "May this year bring you everything you quietly hope for, and even the things you haven't dared to wish for yet. We love you more than words on a screen could ever really say.",
  footerNote: "Made with all our love 💕"
};

/* ══════════════════════════════════════════════════════════════
   PERSISTENCE — restores any edits made through Edit Mode
   ══════════════════════════════════════════════════════════════ */
const LS_KEY = 'birthdaySiteConfig_v1';
const DEFAULT_CONFIG = JSON.parse(JSON.stringify(CONFIG));
try {
  const saved = localStorage.getItem(LS_KEY);
  if (saved) CONFIG = JSON.parse(saved);
} catch (e) { console.warn('Could not load saved edits', e); }

let saveTimer = null;
function saveConfig(){
  clearTimeout(saveTimer);
  saveTimer = setTimeout(() => {
    try { localStorage.setItem(LS_KEY, JSON.stringify(CONFIG)); }
    catch (e) { console.warn('Could not save edits', e); }
  }, 300);
}

function getByPath(obj, path){
  return path.split('.').reduce((cur, key) => cur == null ? cur : cur[isFinite(key) ? Number(key) : key], obj);
}
function setByPath(obj, path, value){
  const parts = path.split('.');
  let cur = obj;
  for (let i = 0; i < parts.length - 1; i++){
    const key = isFinite(parts[i]) ? Number(parts[i]) : parts[i];
    cur = cur[key];
  }
  const lastKey = isFinite(parts[parts.length - 1]) ? Number(parts[parts.length - 1]) : parts[parts.length - 1];
  cur[lastKey] = value;
}

// path -> [elements] sharing the same CONFIG field (e.g. name appears in hero + finale)
const cfgRegistry = {};
function bindText(el, path){
  el.setAttribute('data-cfg', path);
  el.textContent = getByPath(CONFIG, path);
  (cfgRegistry[path] = cfgRegistry[path] || []).push(el);
  return el;
}

/* ══════════════════════════════════════════════════════════════
   RENDER LOGIC — no need to edit below this line
   ══════════════════════════════════════════════════════════════ */

document.title = `Happy Birthday ${CONFIG.name} 🎂`;

// ---------- Photo slot builder (handles placeholder + browse-to-change) ----------
function createPhotoSlot(getSrc, setSrc, altText){
  const slot = document.createElement('div');
  slot.className = 'photo-slot';

  function renderInner(){
    slot.innerHTML = '';
    const src = getSrc();
    if (src && src.trim() !== ''){
      const img = document.createElement('img');
      img.src = src;
      img.alt = altText;
      img.loading = 'lazy';
      slot.appendChild(img);
    } else {
      const ph = document.createElement('div');
      ph.className = 'photo-placeholder';
      ph.innerHTML = `<span class="icon">💗📷</span><span>photo coming soon</span>`;
      slot.appendChild(ph);
    }

    const editBtn = document.createElement('label');
    editBtn.className = 'photo-edit-btn';
    editBtn.innerHTML = `📁 Change Photo`;
    const fileInput = document.createElement('input');
    fileInput.type = 'file';
    fileInput.accept = 'image/*';
    fileInput.style.display = 'none';
    fileInput.addEventListener('click', e => e.stopPropagation());
    fileInput.addEventListener('change', e => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = ev => {
        setSrc(ev.target.result);
        renderInner();
        saveConfig();
      };
      reader.readAsDataURL(file);
    });
    editBtn.appendChild(fileInput);
    slot.appendChild(editBtn);
  }

  renderInner();
  return slot;
}

// ---------- Entry screen text ----------
bindText(document.getElementById('entry-heading'), 'entryHeading');
bindText(document.getElementById('entry-sub'), 'entrySub');
bindText(document.getElementById('entry-btn'), 'entryBtn');

// ---------- Hero ----------
bindText(document.getElementById('hero-badge'), 'heroBadge');
bindText(document.getElementById('hero-title'), 'heroTitle');
bindText(document.getElementById('hero-name'), 'name');
bindText(document.getElementById('hero-sub'), 'heroSub');

// ---------- Memories ----------
const memContainer = document.getElementById('memories-container');
CONFIG.memories.forEach((m, i) => {
  const card = document.createElement('div');
  card.className = 'memory-card glass reveal';

  const dot = document.createElement('div');
  dot.className = 'memory-dot';
  dot.textContent = m.emoji;

  const date = bindText(document.createElement('span'), `memories.${i}.date`);
  date.className = 'memory-date';

  const title = bindText(document.createElement('h3'), `memories.${i}.title`);
  title.className = 'script';

  const text = bindText(document.createElement('p'), `memories.${i}.text`);
  text.className = 'memory-text';

  const photoSlot = createPhotoSlot(
    () => CONFIG.memories[i].photo,
    (val) => { CONFIG.memories[i].photo = val; },
    CONFIG.memories[i].title
  );

  card.append(dot, date, title, text, photoSlot);
  memContainer.appendChild(card);
});

// ---------- Meanings ----------
const meanContainer = document.getElementById('meanings-container');
CONFIG.meanings.forEach((item, i) => {
  const card = document.createElement('div');
  card.className = 'meaning-card glass reveal';

  const icon = document.createElement('div');
  icon.className = 'icon';
  icon.textContent = item.emoji;

  const title = bindText(document.createElement('h3'), `meanings.${i}.title`);
  title.className = 'script';

  const text = bindText(document.createElement('p'), `meanings.${i}.text`);

  card.append(icon, title, text);
  meanContainer.appendChild(card);
});

// ---------- Gallery ----------
const galContainer = document.getElementById('gallery-container');
CONFIG.photos.forEach((p, i) => {
  const rot = (Math.random() * 6 - 3).toFixed(1);
  const card = document.createElement('div');
  card.className = 'polaroid reveal';
  card.style.setProperty('--rot', `${rot}deg`);

  const tape = document.createElement('div');
  tape.className = 'tape';

  const photoSlot = createPhotoSlot(
    () => CONFIG.photos[i].src,
    (val) => { CONFIG.photos[i].src = val; },
    CONFIG.photos[i].caption
  );

  const caption = bindText(document.createElement('div'), `photos.${i}.caption`);
  caption.className = 'caption';

  card.append(tape, photoSlot, caption);
  galContainer.appendChild(card);
});

// ---------- Reasons (flip cards) ----------
const reasonsContainer = document.getElementById('reasons-container');
CONFIG.reasons.forEach((r, i) => {
  const card = document.createElement('div');
  card.className = 'flip-card';

  const inner = document.createElement('div');
  inner.className = 'flip-inner';

  const front = document.createElement('div');
  front.className = 'flip-face flip-front';
  front.innerHTML = `<div class="num script">#${i + 1}</div><div class="tap-label">tap to reveal</div>`;

  const back = document.createElement('div');
  back.className = 'flip-face flip-back';
  const text = bindText(document.createElement('p'), `reasons.${i}.text`);
  const emoji = document.createElement('div');
  emoji.className = 'emoji';
  emoji.textContent = r.emoji;
  back.append(text, emoji);

  inner.append(front, back);
  card.appendChild(inner);
  card.addEventListener('click', () => { if (!editMode) card.classList.toggle('flipped'); });
  reasonsContainer.appendChild(card);
});

// ---------- Cake text ----------
bindText(document.getElementById('cake-text'), 'cakeText');
bindText(document.getElementById('cake-wish'), 'cakeWish');

// ---------- Letter text ----------
bindText(document.getElementById('letter-greeting'), 'letterGreeting');
bindText(document.getElementById('letter-sign'), 'letterSign');
document.getElementById('letter-body').setAttribute('data-cfg', 'letterBody');
(cfgRegistry['letterBody'] = cfgRegistry['letterBody'] || []).push(document.getElementById('letter-body'));

// ---------- Finale text ----------
bindText(document.getElementById('finale-line'), 'finaleLine');
bindText(document.getElementById('finale-name'), 'name');
bindText(document.getElementById('finale-wish'), 'finaleWish');
bindText(document.getElementById('footer-note'), 'footerNote');

/* ══════════════════════════════════════════════════════════════
   PARTICLES
   ══════════════════════════════════════════════════════════════ */
const particleField = document.getElementById('particles');
const particleEmojis = ['💖', '✨', '🌸', '⭐', '💫'];
const PARTICLE_COUNT = 26;
for (let i = 0; i < PARTICLE_COUNT; i++){
  const p = document.createElement('div');
  const useEmoji = Math.random() > 0.45;
  const left = Math.random() * 100;
  const duration = 10 + Math.random() * 12;
  const delay = Math.random() * 14;
  p.style.left = `${left}vw`;
  p.style.animationDuration = `${duration}s`;
  p.style.animationDelay = `${delay}s`;
  if (useEmoji){
    p.className = 'particle emoji';
    p.style.fontSize = `${14 + Math.random() * 14}px`;
    p.textContent = particleEmojis[Math.floor(Math.random() * particleEmojis.length)];
  } else {
    p.className = 'particle dot';
    const size = 5 + Math.random() * 6;
    p.style.width = `${size}px`;
    p.style.height = `${size}px`;
    const colors = ['#e8a4a0', '#cbb3ff', '#f3c96b', '#ffb3d1'];
    p.style.background = colors[Math.floor(Math.random() * colors.length)];
  }
  particleField.appendChild(p);
}

/* ══════════════════════════════════════════════════════════════
   ENTRY OVERLAY INTERACTION
   ══════════════════════════════════════════════════════════════ */
const entryOverlay = document.getElementById('entry-overlay');
const entryBtn = document.getElementById('entry-btn');

function fireConfettiBurst(){
  if (typeof confetti !== 'function') return;
  confetti({
    particleCount: 130,
    spread: 80,
    origin: { y: 0.6 },
    colors: ['#ffb3d1', '#cbb3ff', '#f3c96b', '#e8a4a0', '#fff6ee']
  });
}

entryBtn.addEventListener('click', () => {
  fireConfettiBurst();
  entryOverlay.classList.add('hide');
  document.body.classList.remove('lock-scroll');
  setTimeout(() => { entryOverlay.style.display = 'none'; }, 850);
});

/* ══════════════════════════════════════════════════════════════
   REVEAL ON SCROLL
   ══════════════════════════════════════════════════════════════ */
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting){
      entry.target.classList.add('in-view');
      revealObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.15 });

document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

/* ══════════════════════════════════════════════════════════════
   INTERACTIVE CAKE
   ══════════════════════════════════════════════════════════════ */
const cakeWrap = document.getElementById('cake-wrap');
const cakeWishEl = document.getElementById('cake-wish');
let cakeBlown = false;

cakeWrap.addEventListener('click', () => {
  if (editMode || cakeBlown) return;
  cakeBlown = true;
  document.querySelectorAll('[data-flame]').forEach(f => f.classList.add('out'));
  setTimeout(() => {
    fireConfettiBurst();
    cakeWishEl.classList.add('show');
  }, 500);
});

/* ══════════════════════════════════════════════════════════════
   LETTER SECTION
   ══════════════════════════════════════════════════════════════ */
const letterEnvelope = document.getElementById('letter-envelope');
const letterPaper = document.getElementById('letter-paper');
const letterBodyEl = document.getElementById('letter-body');
let letterOpened = false;
let letterTypeToken = 0;

function typewrite(text, el){
  const myToken = ++letterTypeToken;
  let i = 0;
  const cursor = document.createElement('span');
  cursor.className = 'cursor-blink';
  cursor.textContent = ' ';
  function step(){
    if (myToken !== letterTypeToken) return;
    if (i <= text.length){
      el.textContent = text.slice(0, i);
      el.appendChild(cursor);
      i++;
      const extraPause = (i % 40 === 0) ? 260 : 0;
      setTimeout(step, 18 + extraPause);
    } else {
      cursor.remove();
    }
  }
  step();
}

letterEnvelope.addEventListener('click', () => {
  if (editMode || letterOpened) return;
  letterOpened = true;
  letterEnvelope.classList.add('hidden');
  letterPaper.classList.add('show');
  typewrite(CONFIG.letterBody, letterBodyEl);
});

/* ══════════════════════════════════════════════════════════════
   GRAND FINALE
   ══════════════════════════════════════════════════════════════ */
const finaleBtnWrap = document.getElementById('finale-btn-wrap');
const finaleBtn = document.getElementById('finale-btn');
const finaleContent = document.getElementById('finale-content');
let finaleTriggered = false;

finaleBtn.addEventListener('click', () => {
  if (editMode || finaleTriggered) return;
  finaleTriggered = true;
  finaleBtnWrap.classList.add('hidden');
  finaleContent.classList.add('show');

  const duration = 3000;
  const end = Date.now() + duration;
  const colors = ['#ffb3d1', '#cbb3ff', '#f3c96b', '#e8a4a0', '#c0426b'];

  const interval = setInterval(() => {
    if (Date.now() > end){
      clearInterval(interval);
      return;
    }
    if (typeof confetti === 'function'){
      confetti({
        particleCount: 40,
        startVelocity: 55,
        spread: 100,
        origin: { x: Math.random(), y: Math.random() * 0.4 },
        colors
      });
    }
  }, 200);
});

/* ══════════════════════════════════════════════════════════════
   EDIT MODE — browse-to-change photos & click-to-edit text,
   with autosave + backup/restore so nothing gets lost.
   ══════════════════════════════════════════════════════════════ */
// Flip to true to bring editing back — that's the only change needed.
const EDIT_MODE_ENABLED = true;

let editMode = false;
const editToggleBtn = document.getElementById('edit-toggle-btn');
const editDoneBtn = document.getElementById('edit-done-btn');
const editResetBtn = document.getElementById('edit-reset-btn');
const editBackupBtn = document.getElementById('edit-backup-btn');
const editRestoreBtn = document.getElementById('edit-restore-btn');
const editRestoreInput = document.getElementById('edit-restore-input');

if (!EDIT_MODE_ENABLED){
  editToggleBtn.style.display = 'none';
}

function enableEditMode(){
  if (!EDIT_MODE_ENABLED) return;
  editMode = true;
  document.body.classList.add('edit-mode');
  document.body.classList.remove('lock-scroll');
  document.querySelectorAll('[data-cfg]').forEach(el => el.setAttribute('contenteditable', 'true'));
  letterTypeToken++; // stop any in-progress typewriter
  letterBodyEl.textContent = CONFIG.letterBody;
}

function disableEditMode(){
  editMode = false;
  document.body.classList.remove('edit-mode');
  document.querySelectorAll('[data-cfg]').forEach(el => el.removeAttribute('contenteditable'));
  if (!letterOpened){ letterBodyEl.textContent = ''; }
}

editToggleBtn.addEventListener('click', () => {
  if (editMode) disableEditMode(); else enableEditMode();
});
editDoneBtn.addEventListener('click', disableEditMode);

// Delegated listener: any [data-cfg] element being typed into updates CONFIG live
document.addEventListener('input', (e) => {
  if (!editMode) return;
  const el = e.target.closest('[data-cfg]');
  if (!el) return;
  const path = el.getAttribute('data-cfg');
  const value = (el.innerText !== undefined ? el.innerText : el.textContent).replace(/\r\n/g, '\n');
  setByPath(CONFIG, path, value);
  (cfgRegistry[path] || []).forEach(other => {
    if (other !== el) other.textContent = value;
  });
  if (path === 'name'){ document.title = `Happy Birthday ${value} 🎂`; }
  saveConfig();
});

// Download a JSON backup of everything (text edits + embedded photos)
editBackupBtn.addEventListener('click', () => {
  const blob = new Blob([JSON.stringify(CONFIG, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `birthday-site-backup-${CONFIG.name.replace(/\s+/g, '_')}.json`;
  a.click();
  URL.revokeObjectURL(url);
});

// Restore edits from a previously downloaded JSON backup
editRestoreBtn.addEventListener('click', () => editRestoreInput.click());
editRestoreInput.addEventListener('change', (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = (ev) => {
    try {
      const parsed = JSON.parse(ev.target.result);
      localStorage.setItem(LS_KEY, JSON.stringify(parsed));
      location.reload();
    } catch (err){
      alert('That file could not be read as a valid backup.');
    }
  };
  reader.readAsText(file);
});

// Wipe all edits and restore the original CONFIG written in the code
editResetBtn.addEventListener('click', () => {
  if (!confirm('Reset all edits back to the original content? This cannot be undone.')) return;
  localStorage.removeItem(LS_KEY);
  location.reload();
});
</script>
</body>
</html>
